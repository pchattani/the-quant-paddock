{"ok":true,"year":2008,"metrics":[{"key":"points","label":"Points","group":"Results","fmt":"1","lower":false,"scope":"results","desc":"Constructors' points as awarded (Grand Prix, sprint and fastest-lap points of every car)."},{"key":"points_per_race","label":"Points per race","group":"Results","fmt":"2","lower":false,"scope":"results","desc":"Points divided by rounds entered."},{"key":"wins","label":"Wins","group":"Results","fmt":"int","lower":false,"scope":"results","desc":"Grand Prix wins by either car."},{"key":"podiums","label":"Podiums","group":"Results","fmt":"int","lower":false,"scope":"results","desc":"Podium finishes by any car."},{"key":"poles","label":"Poles","group":"Results","fmt":"int","lower":false,"scope":"qualifying","desc":"Pole positions by any car."},{"key":"one_twos","label":"One-twos","group":"Results","fmt":"int","lower":false,"scope":"results","desc":"Races the team finished first and second."},{"key":"both_points_rate","label":"Both cars in the points","group":"Results","fmt":"prob","lower":false,"scope":"results","desc":"Share of rounds in which every car that started scored points."},{"key":"avg_best_finish","label":"Average best-car finish","group":"Results","fmt":"1","lower":true,"scope":"results","desc":"Mean finishing position of the team's better-placed classified car. Lower is better."},{"key":"avg_best_grid","label":"Average best-car grid","group":"Results","fmt":"1","lower":true,"scope":"results","desc":"Mean starting slot of the team's better-placed car. Lower is better."},{"key":"exp_points","label":"Expected points","group":"Results","fmt":"1","lower":false,"scope":"model","desc":"Sum of the walk-forward forecast's expected points for the team's cars."},{"key":"points_v_expected","label":"Points v expected","group":"Results","fmt":"signed","lower":false,"scope":"model","desc":"Points minus expected points, summed over the team's car-races."},{"key":"car_race_pace","label":"Car race pace (% v field)","group":"Car pace","fmt":"3"