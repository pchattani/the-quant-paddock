{"ok":true,"year":1950,"metrics":[{"key":"points","label":"Points","group":"Results","fmt":"1","lower":false,"scope":"results","desc":"Constructors' points as awarded (Grand Prix, sprint and fastest-lap points of every car)."},{"key":"points_per_race","label":"Points per race","group":"Results","fmt":"2","lower":false,"scope":"results","desc":"Points divided by rounds entered."},{"key":"wins","label":"Wins","group":"Results","fmt":"int","lower":false,"scope":"results","desc":"Grand Prix wins by either car."},{"key":"podiums","label":"Podiums","group":"Results","fmt":"int","lower":false,"scope":"results","desc":"Podium finishes by any car."},{"key":"poles","label":"Poles","group":"Results","fmt":"int","lower":false,"scope":"qualifying","desc":"Pole positions by any car."},{"key":"one_twos","label":"One-twos","group":"Results","fmt":"int","lower":false,"scope":"results","desc":"Races the team finished first and second."},{"key":"both_points_rate","label":"Both cars in the points","group":"Results","fmt":"prob","lower":false,"scope":"results","desc":"Share of rounds in which every car that started scored points."},{"key":"avg_best_finish","label":"Average best-car finish","group":"Results","fmt":"1","lower":true,"scope":"results","desc":"Mean finishing position of the team's better-placed classified car. Lower is better."},{"key":"avg_best_grid","label":"Average best-car grid","group":"Results","fmt":"1","lower":true,"scope":"results","desc":"Mean starting slot of the team's better-placed car. Lower is better."},{"key":"exp_points","label":"Expected points","group":"Results","fmt":"1","lower":false,"scope":"model","desc":"Sum of the walk-forward forecast's expected points for the team's cars."},{"key":"points_v_expected","label":"Points v expected","group":"Results","fmt":"signed","lower":false,"scope":"model","desc":"Points minus expected points, summed over the team's car-races."},{"key":"car_race_pace","label":"Car race pace (% v field)","group":"Car pace","fmt":"3","lower":true,"scope":"laps","desc":"The car part of the season's race-pace decomposition, in percent of the lap against the field (negative is faster), averaged over the rounds it was observed. The car's level is a random walk from round to round, so upgrades and circuit swings show up as movement. Lower is better."},{"key":"car_race_rank","label":"Car race-pace rank","group":"Car pace","fmt":"1","lower":true,"scope":"laps","desc":"Mean rank of the car's race-pace state among the teams at each round (1 = fastest). Lower is better."},{"key":"car_quali_pace","label":"Car qualifying pace (% v field)","group":"Car pace","fmt":"3","lower":true,"scope":"qualifying","desc":"The car part of the qualifying-pace decomposition, percent of the lap against the field. Lower is better."},{"key":"car_quali_rank","label":"Car qualifying-pace rank","group":"Car pace","fmt":"1","lower":true,"scope":"qualifying","desc":"Mean rank of the car's qualifying-pace state at each round. Lower is better."},{"key":"car_pace_trend","label":"Car pace trend (%)","group":"Car pace","fmt":"3","lower":true,"scope":"laps","desc":"Car race pace over the last third of the rounds minus the first third, percent of the lap. Negative means the car got faster relative to the field. Lower is better."},{"key":"car_pace_latest","label":"Car race pace, latest (%)","group":"Car pace","fmt":"3","lower":true,"scope":"laps","desc":"The car's race-pace state at the latest modelled round, percent of the lap. Lower is better."},{"key":"top_speed","label":"Top speed (km/h)","group":"Profile","fmt":"1","lower":false,"scope":"openf1","desc":"Mean of the team's drivers' top speed-trap readings, km/h."},{"key":"speed_trap_rank","label":"Speed-trap rank","group":"Profile","fmt":"1","lower":true,"scope":"openf1","desc":"Mean speed-trap rank of the team's drivers. Lower is better."},{"key":"corner_speed","label":"Minimum corner speed v field (km/h)","group":"Profile","fmt":"1","lower":false,"scope":"telemetry","desc":"Mean of 